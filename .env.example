# Storage layout. Default is /data:
#   <data_dir>/market/<TICKER>/<YEAR>.parquet     (one file per ticker per year)
#   <data_dir>/constituents/<TICKER>.parquet     (one file per ticker)
DATA_DIR=./data

# Polygon.io
POLYGON_API_KEY=
# POLYGON_BASE_URL=https://api.polygon.io

# Interactive Brokers (paper trading only).
# IB_USER / IB_PASSWORD are passed to the unified market-data container
# as TWS_USERID / TWS_PASSWORD so IB Gateway can log in to TWS.
# IB Gateway runs in the same container as the FastAPI app, so the app
# reaches it on 127.0.0.1:4004.
IB_USER=
IB_PASSWORD=
IBKR_TIMEOUT_SECONDS=10

# App
APP_PORT=3556

# Storage layout. Default is /data:
#   <data_dir>/market/<TICKER>/<YEAR>.parquet     (one file per ticker per year)
#   <data_dir>/constituents/<TICKER>.parquet     (one file per ticker)
DATA_DIR=./data

# Polygon.io
POLYGON_API_KEY=
# POLYGON_BASE_URL=https://api.polygon.io

# Interactive Brokers (via gnzsnz/ib-gateway-docker).
# IB_USER / IB_PASSWORD are read by docker-compose.yml and passed to the
# ib-gateway container as TWSUSERID / TWSPASSWORD so it can log in to TWS.
IB_USER=
IB_PASSWORD=
IBKR_HOST=ib-gateway
IBKR_TRADING_MODE=paper
IBKR_CLIENT_ID=1
IBKR_TIMEOUT_SECONDS=10

# App
APP_PORT=8001

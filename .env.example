# Storage layout. Default is /data:
#   <data_dir>/market/<TICKER>/<YEAR>.parquet     (one file per ticker per year)
#   <data_dir>/constituents/<TICKER>.parquet     (one file per ticker)
DATA_DIR=./data

# Polygon.io
POLYGON_API_KEY=
# POLYGON_BASE_URL=https://api.polygon.io

# Longbridge OpenAPI (API Key auth).
# Credentials come from https://open.longbridge.com/ (developer center).
# Region is selectable via LONGBRIDGE_REGION (cn / hk); the SDK picks an
# endpoint automatically. LONGIBRIDGE_REGION_SUFFIX controls how bare US
# tickers (e.g. AAPL) are formatted before being sent upstream.
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
LONGBRIDGE_TIMEOUT_SECONDS=10

# App
APP_PORT=3556

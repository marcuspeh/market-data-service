# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Polygon.io
POLYGON_API_KEY=
# POLYGON_BASE_URL=https://api.polygon.io

# Interactive Brokers (via gnzsnz/ib-gateway-docker).
# IBKR_TWS_USERID / IBKR_TWS_PASSWORD are passed to the ib-gateway container
# so it can log in. TRADING_MODE controls whether the gateway starts in
# paper or live mode inside the container.
IBKR_TRADING_MODE=paper
IBKR_TWS_USERID=
IBKR_TWS_PASSWORD=
IBKR_ACCEPT_INCOMING=manual
IBKR_TWOFA_TIMEOUT_ACTION=exit
IBKR_TIME_ZONE=Etc/UTC
IBKR_CLIENT_ID=1
IBKR_TIMEOUT_SECONDS=10

# App
APP_PORT=8001